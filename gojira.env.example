# Gojira install values. Copy to gojira.env (gitignored), fill in, then
# `make install`. Every scripts/*.sh reads this file; a variable already in
# your environment wins over the file. Plain KEY=value lines, no quotes.

# --- required -----------------------------------------------------------------
PROJECT=my-gcp-project
REGION=us-central1
# The GKE cluster Gojira runs in. terraform/ creates gojira-sandbox; for an
# existing cluster set its name and GOJIRA_PREPARE_PROJECT=1 below.
CLUSTER=gojira-sandbox
# Your GitHub App (docs/github-app-setup.md): numeric id + downloaded key.
GOJIRA_GITHUB_APP_ID=1234567
GOJIRA_GITHUB_APP_PEM=./github-app.pem

# --- the cluster underneath: pick one, or neither -----------------------------
# 1 = make install creates the cluster and Gojira's identity with terraform/
# (about 10 minutes the first time, seconds after). It never deletes or
# replaces anything; make uninstall takes it all down again. Leave empty if
# you run terraform yourself.
GOJIRA_TERRAFORM=

# --- existing project / cluster (brownfield) ---------------------------------
# 1 = run scripts/prepare-project.sh first (APIs, GSA, roles, AR, Workload
# Identity). Leave empty when terraform/ built the project — it did all that.
GOJIRA_PREPARE_PROJECT=
# 1 = reach the cluster over GKE's IAM-authenticated DNS endpoint (private
# control planes with no public endpoint).
GOJIRA_DNS_ENDPOINT=
# internal = this machine is inside the cluster's network (VPN) and the control
# plane's DNS endpoint is to stay closed: the install scripts use the private
# endpoint. Register clusters with access "internal" too, and point
# GOJIRA_CI_RUNNER at a runner inside that network. Empty = dns.
GOJIRA_CLUSTER_ACCESS=

# --- front door (optional): HTTPS + Identity-Aware Proxy ---------------------
# Setting a hostname provisions a static IP, managed cert, IAP client and
# ingress. Then create the DNS A record the script prints.
GOJIRA_HOSTNAME=
# Who may pass IAP, comma-separated: domain:example.com,user:a@example.com
GOJIRA_IAP_MEMBERS=
# Gojira's own allowlist behind IAP (auth: turns on when either is set AND
# GOJIRA_HOSTNAME is set — never without a proxy in front).
GOJIRA_ALLOWED_DOMAIN=
GOJIRA_ALLOWED_EMAILS=

# --- platform knobs (optional) -----------------------------------------------
# Labels stamped on every namespace Gojira creates (secrets infra often gates
# on these). YAML flow map:  {example.com/team: sre}
GOJIRA_NAMESPACE_LABELS=
# The architecture apps are built for and scheduled on when their gojira.yaml
# doesn't say (`arch:` there wins). Empty = amd64. Prefer arm64 where your
# runners can build it and your clusters can run it — it is cheaper and more
# available than amd64 on GCP and AWS — but a GitHub-hosted ubuntu-latest
# runner cannot build arm64, so leave this empty with hosted runners.
GOJIRA_DEFAULT_ARCH=
# How your clusters provide that arch, added to every pod's nodeSelector when
# the contract has none. Autopilot arm64:  {cloud.google.com/compute-class: Scale-Out}
GOJIRA_DEFAULT_NODE_SELECTOR=
# The cluster each environment name means on this install, used when a
# connect request (API or kobo) names an environment without a cluster.
# YAML flow map:  {dev: gojira-sandbox}
GOJIRA_ENVIRONMENT_CLUSTERS=
# Project roles an app may ask for in its gojira.yaml (identity.gcp_roles):
# Gojira makes the app a Google service account, grants these, and binds
# the pod to it. Comma list; empty means no app may declare an identity.
#   roles/aiplatform.user,roles/storage.objectViewer
GOJIRA_GRANTABLE_ROLES=
# ClusterRoles an app may ask to be bound to (gojira.yaml cluster_roles).
# You apply the ClusterRole once, as a cluster admin; Gojira makes the
# binding for the app's ServiceAccount. Comma list; empty means refused.
GOJIRA_GRANTABLE_CLUSTER_ROLES=
# Values a gojira.yaml may reference instead of writing, e.g. a package index
# that lives in THIS install's project: the contract says
#   build_args: {EXTRA_INDEX_URL: ${GOJIRA_PYTHON_INDEX}}
# and this map says what GOJIRA_PYTHON_INDEX is here. Gojira sets each as an
# Actions variable on every connected repo. YAML flow map:
#   {GOJIRA_PYTHON_INDEX: https://us-central1-python.pkg.dev/p/tenish/simple/}
GOJIRA_REPO_VARIABLES=
# Optional: an image of the sizing agent (gojira-sizing-agent, not yet
# published); enables the Clusters page "Deploy agent" button.
GOJIRA_SIZING_AGENT_IMAGE=
# Born observed: your build of github.com/tenishai/argus, digest-pinned, and
# the comma-separated names of registered clusters whose apps it observes.
# Both empty = the observe step skips (an unobserved app beats an undeployed one).
GOJIRA_OBSERVE_JOB_IMAGE=
GOJIRA_OBSERVE_CLUSTERS=
# Central drift detector (docs/design.md).
GOJIRA_DRIFT_ENABLED=true
# Self-hosted runners: the label your runners carry (e.g. my-runners). Generated
# workflows run on `vars.GOJIRA_CI_RUNNER || ubuntu-latest`; Gojira sets that
# variable on every private repo it connects and removes it when this is
# emptied; a public repo never gets one. The runner needs only docker (the
# workflow fetches the rest). Empty = GitHub's hosted runners.
GOJIRA_CI_RUNNER=
