# Gojira app spec — this file is the contract between your repo and Gojira.
# Change the class or add overrides here; Gojira regenerates the manifests
# when this file changes.
app: {{ spec.app }}
class: {{ spec.workload_class }}
environments:
{% for env in spec.environments %}
  - name: {{ env.name }}
    cluster: {{ env.cluster_name }}
    namespace: {{ env.namespace }}
{% endfor %}
{% if spec.schedule %}
schedule: "{{ spec.schedule }}"
{% endif %}
{% if spec.service_account %}
service_account: {{ spec.service_account }}
{% endif %}
{% if spec.secrets_from %}
secrets_from: [{{ spec.secrets_from | join(", ") }}]
{% endif %}
{% if spec.config_from %}
config_from: [{{ spec.config_from | join(", ") }}]
{% endif %}
{% if spec.env_vars %}
env:
{% for k, v in spec.env_vars | dictsort %}
  {{ k }}: {{ v | tojson }}
{% endfor %}
{% endif %}
{% if spec.data_mount %}
data_mount: { pvc: {{ spec.data_mount.pvc }}, path: {{ spec.data_mount.path }}, fs_group: {{ spec.data_mount.fs_group }} }
{% endif %}
{% if spec.overrides %}
overrides:
{% if spec.overrides.requests %}
  requests: { {% for k, v in spec.overrides.requests | dictsort %}{{ k }}: "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
{% if spec.overrides.limits %}
  limits: { {% for k, v in spec.overrides.limits | dictsort %}{{ k }}: "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
  justification: {{ spec.overrides.justification | tojson }}
{% else %}
# overrides:                  # needs a justification — see docs
#   requests: { cpu: "1", memory: 1Gi }
#   justification: "measured p99 over 14 days"
{% endif %}
