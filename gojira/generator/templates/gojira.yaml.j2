# Gojira app spec — this file is the contract between your repo and Gojira.
# Change the class or add overrides here; Gojira regenerates the manifests
# when this file changes.
app: {{ spec.app }}
class: {{ spec.workload_class }}
environments:
{% for env in spec.environments %}
  - name: {{ env.name }}
    cluster: {{ env.cluster_name }}
    namespace: {{ env.namespace }}
{% endfor %}
{% if spec.schedule %}
schedule: "{{ spec.schedule }}"
{% endif %}
{% if spec.service_account %}
service_account: {{ spec.service_account }}
{% endif %}
{% if spec.secrets_from %}
secrets_from: [{{ spec.secrets_from | join(", ") }}]
{% endif %}
{% if spec.config_from %}
config_from: [{{ spec.config_from | join(", ") }}]
{% endif %}
{% if spec.env_vars %}
env:
{% for k, v in spec.env_vars | dictsort %}
  {{ k }}: {{ v | quoted }}
{% endfor %}
{% endif %}
{% if spec.data_mount %}
data_mount: { pvc: {{ spec.data_mount.pvc }}, path: {{ spec.data_mount.path }}, fs_group: {{ spec.data_mount.fs_group }} }
{% endif %}
{% if spec.config_mounts %}
config_mounts:                # ConfigMaps read as files (key: one entry as that file)
{% for m in spec.config_mounts %}
  - { name: {{ m.name }}, path: {{ m.path }}{% if m.key %}, key: {{ m.key }}{% endif %} }
{% endfor %}
{% endif %}
{% if spec.secret_mounts %}
secret_mounts:                # Secrets read as files
{% for m in spec.secret_mounts %}
  - { name: {{ m.name }}, path: {{ m.path }}{% if m.key %}, key: {{ m.key }}{% endif %} }
{% endfor %}
{% endif %}
{% if spec.build_args %}
build_args:                   # passed to docker build; in git, so never a secret
{% for k, v in spec.build_args | dictsort %}
  {{ k }}: {{ v | quoted }}
{% endfor %}
{% endif %}
{% if spec.port != 8080 %}
port: {{ spec.port }}
{% endif %}
{% if spec.arch %}
arch: {{ spec.arch }}                  # image platform + node arch; unset: the platform's default
{% endif %}
{% if spec.node_selector %}
node_selector:                # added to the pod verbatim (how this cluster provides arm64, a pool, …)
{% for k, v in spec.node_selector | dictsort %}
  {{ k }}: {{ v | quoted }}
{% endfor %}
{% endif %}
{% if spec.health %}
health: {{ spec.health }}
{% endif %}
{% if spec.admin_port %}
admin_port: {{ spec.admin_port }}
{% endif %}
{% if spec.overrides %}
overrides:
{% if spec.overrides.requests %}
  requests: { {% for k, v in spec.overrides.requests | dictsort %}{{ k }}: "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
{% if spec.overrides.limits %}
  limits: { {% for k, v in spec.overrides.limits | dictsort %}{{ k }}: "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
{% if spec.overrides.hpa %}
  hpa: { {% for k in ["min", "max", "cpu", "memory"] if spec.overrides.hpa[k] is not none %}{{ k }}: {{ spec.overrides.hpa[k] }}{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
  justification: {{ spec.overrides.justification | quoted }}
{% else %}
# overrides:                  # needs a justification — see docs
#   requests: { cpu: "1", memory: 1Gi }
#   justification: "measured p99 over 14 days"
{% endif %}
