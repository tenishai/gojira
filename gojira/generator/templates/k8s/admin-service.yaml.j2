# Generated by Gojira.
# The admin plane's own Service: separable reachability for the second
# listener a gateway-class app declares via admin_port. Deliberately NOT a
# port on the main Service -- who may reach admin is a routing/NetworkPolicy
# decision, and the data plane's Service must never answer for it.
apiVersion: v1
kind: Service
metadata:
  name: {{ spec.app }}-admin
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
spec:
  selector:
    app.kubernetes.io/name: {{ spec.app }}
  ports:
    - name: admin
      port: 80
      targetPort: admin
