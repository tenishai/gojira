# Generated by Gojira. Default alerting rules — a starting point, not a
# complete SLO. Add app-specific rules in your own files; Gojira won't
# touch them.
apiVersion: monitoring.googleapis.com/v1
kind: Rules
metadata:
  name: {{ spec.app }}-defaults
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
spec:
  groups:
    - name: gojira-defaults
      interval: 30s
      rules:
        - alert: GojiraAppScrapeDown
          expr: up{job="{{ spec.app }}"} == 0
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "{{ spec.app }}: metrics endpoint not reachable for 5m"
