# Generated by Gojira. Bounds come from the '{{ cls.name }}' workload class.
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ spec.app }}
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ spec.app }}
  minReplicas: {{ cls.hpa.min_replicas }}
  maxReplicas: {{ cls.hpa.max_replicas }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ cls.hpa.target_cpu_percent }}
