# Generated by Gojira. Google Managed Prometheus scrape target —
# every Gojira app serves /metrics on its http port.
apiVersion: monitoring.googleapis.com/v1
kind: PodMonitoring
metadata:
  name: {{ spec.app }}
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ spec.app }}
  endpoints:
    - port: http
      path: /metrics
      interval: 15s
