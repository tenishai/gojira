# Generated by Gojira. Sizing comes from the '{{ cls.name }}' workload class —
# override in gojira.yaml with a justification, not here.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ spec.app }}
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
    gojira.dev/class: {{ cls.name }}
spec:
{% if not cls.hpa %}
  replicas: 1
{% endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ spec.app }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ spec.app }}
        gojira.dev/managed: "true"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ port }}"
        prometheus.io/path: /metrics
    spec:
{% if spec.service_account %}
      serviceAccountName: {{ spec.service_account }}
{% endif %}
      containers:
        - name: app
          image: gojira-app
          ports:
            - name: http
              containerPort: {{ port }}
{% if spec.secrets_from %}
          envFrom:
{% for secret in spec.secrets_from %}
            - secretRef:
                name: {{ secret }}
{% endfor %}
{% endif %}
{% if spec.data_mount %}
          volumeMounts:
            - name: data
              mountPath: {{ spec.data_mount.path }}
{% endif %}
          resources:
            requests:
              cpu: {{ cls.requests.cpu }}
              memory: {{ cls.requests.memory }}
              ephemeral-storage: {{ ephemeral.requests }}
{% if cls.requests.gpu %}
              nvidia.com/gpu: {{ cls.requests.gpu }}
{% endif %}
            limits:
              cpu: {{ cls.limits.cpu }}
              memory: {{ cls.limits.memory }}
              ephemeral-storage: {{ ephemeral.limits }}
{% if cls.limits.gpu %}
              nvidia.com/gpu: {{ cls.limits.gpu }}
{% endif %}
{% if "readiness" in cls.probes %}
          readinessProbe:
{% if cls.probes["readiness"].type == "http" %}
            httpGet:
              path: {{ cls.probes["readiness"].path }}
              port: http
{% else %}
            tcpSocket:
              port: http
{% endif %}
            initialDelaySeconds: 5
            periodSeconds: 10
{% endif %}
{% if "liveness" in cls.probes %}
          livenessProbe:
{% if cls.probes["liveness"].type == "http" %}
            httpGet:
              path: {{ cls.probes["liveness"].path }}
              port: http
{% else %}
            tcpSocket:
              port: http
{% endif %}
            initialDelaySeconds: 15
            periodSeconds: 20
{% endif %}
{% if spec.data_mount %}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ spec.data_mount.pvc }}
{% endif %}
