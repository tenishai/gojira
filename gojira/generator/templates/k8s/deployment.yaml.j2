# Generated by Gojira. Sizing comes from the '{{ cls.name }}' workload class —
# override in gojira.yaml with a justification, not here.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ spec.app }}
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
    gojira.dev/class: {{ cls.name }}
spec:
{% if cls.strategy %}
  strategy:
    type: {{ cls.strategy }}
{% endif %}
{% if not cls.hpa %}
  replicas: 1
{% endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ spec.app }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ spec.app }}
        gojira.dev/managed: "true"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ port }}"
        prometheus.io/path: /metrics
    spec:
{% if spec.service_account %}
      serviceAccountName: {{ spec.service_account }}
{% endif %}
{% if spec.data_mount %}
      securityContext:
        fsGroup: {{ spec.data_mount.fs_group }}
{% endif %}
{% if spec.arch != "amd64" or spec.node_selector %}
      nodeSelector:
{% if spec.arch != "amd64" %}
        kubernetes.io/arch: {{ spec.arch }}
{% endif %}
{% for k, v in spec.node_selector | dictsort %}
        {{ k }}: {{ v | quoted }}
{% endfor %}
{% endif %}
{% if spec.arch == "arm64" %}
      tolerations:
        - { key: kubernetes.io/arch, operator: Equal, value: arm64, effect: NoSchedule }
{% endif %}
      containers:
        - name: app
          image: gojira-app
          ports:
            - name: http
              containerPort: {{ port }}
{% if spec.admin_port %}
            - name: admin
              containerPort: {{ spec.admin_port }}
{% endif %}
{% if spec.env_vars %}
          env:
{% for k, v in spec.env_vars | dictsort %}
            - name: {{ k }}
              value: {{ v | quoted }}
{% endfor %}
{% endif %}
{% if spec.secrets_from or spec.config_from %}
          envFrom:
{% for secret in spec.secrets_from %}
            - secretRef:
                name: {{ secret }}
{% endfor %}
{% for cm in spec.config_from %}
            - configMapRef:
                name: {{ cm }}
{% endfor %}
{% endif %}
{% if spec.data_mount or spec.config_mounts or spec.secret_mounts %}
          volumeMounts:
{% if spec.data_mount %}
            - name: data
              mountPath: {{ spec.data_mount.path }}
{% endif %}
{% for m in spec.config_mounts + spec.secret_mounts %}
            - name: {{ m.volume }}
              mountPath: {{ m.path }}
{% if m.key %}
              subPath: {{ m.key }}
{% endif %}
              readOnly: true
{% endfor %}
{% endif %}
          resources:
            requests:
              cpu: {{ cls.requests.cpu }}
              memory: {{ cls.requests.memory }}
              ephemeral-storage: {{ ephemeral.requests }}
{% if cls.requests.gpu %}
              nvidia.com/gpu: {{ cls.requests.gpu }}
{% endif %}
            limits:
              cpu: {{ cls.limits.cpu }}
              memory: {{ cls.limits.memory }}
              ephemeral-storage: {{ ephemeral.limits }}
{% if cls.limits.gpu %}
              nvidia.com/gpu: {{ cls.limits.gpu }}
{% endif %}
{% if "readiness" in probes %}
          readinessProbe:
{% if probes["readiness"].type == "http" %}
            httpGet:
              path: {{ probes["readiness"].path }}
              port: http
{% else %}
            tcpSocket:
              port: http
{% endif %}
            initialDelaySeconds: 5
            periodSeconds: 10
{% endif %}
{% if "liveness" in probes %}
          livenessProbe:
{% if probes["liveness"].type == "http" %}
            httpGet:
              path: {{ probes["liveness"].path }}
              port: http
{% else %}
            tcpSocket:
              port: http
{% endif %}
            initialDelaySeconds: 15
            periodSeconds: 20
{% endif %}
{% if spec.data_mount or spec.config_mounts or spec.secret_mounts %}
      volumes:
{% if spec.data_mount %}
        - name: data
          persistentVolumeClaim:
            claimName: {{ spec.data_mount.pvc }}
{% endif %}
{% for m in spec.config_mounts %}
        - name: {{ m.volume }}
          configMap:
            name: {{ m.name }}
{% endfor %}
{% for m in spec.secret_mounts %}
        - name: {{ m.volume }}
          secret:
            secretName: {{ m.name }}
{% endfor %}
{% endif %}
