# Generated by Gojira. The image tag is set by CI at deploy time
# (kustomize edit set image) — don't pin it by hand.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ spec.namespace }}
resources:
  - ../../base
labels:
  - pairs:
      gojira.dev/env: {{ env }}
images:
  - name: gojira-app
    newName: {{ spec.image }}
    newTag: latest
