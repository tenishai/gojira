# Generated by Gojira. Sizing comes from the 'cron' workload class —
# override in gojira.yaml with a justification, not here.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ spec.app }}
  labels:
    app.kubernetes.io/name: {{ spec.app }}
    gojira.dev/managed: "true"
    gojira.dev/class: cron
spec:
  schedule: "{{ spec.schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        metadata:
          labels:
            app.kubernetes.io/name: {{ spec.app }}
            gojira.dev/managed: "true"
        spec:
          restartPolicy: Never
          containers:
            - name: app
              image: gojira-app
              resources:
                requests:
                  cpu: {{ cls.requests.cpu }}
                  memory: {{ cls.requests.memory }}
                  ephemeral-storage: {{ ephemeral.requests }}
                limits:
                  cpu: {{ cls.limits.cpu }}
                  memory: {{ cls.limits.memory }}
                  ephemeral-storage: {{ ephemeral.limits }}
