{# ${{ vars.GOJIRA_<ENV>_<FACT> }} — the install's facts come from repository
   variables Gojira sets, never from literals in this file (issue #87). #}
{% macro v(env, fact) -%}
${{ '{{' }} vars.{{ env.var_prefix }}_{{ fact }} {{ '}}' }}
{%- endmacro %}

{% macro require_vars(env, names) %}
      - name: Platform variables for {{ env.name }}
        # Gojira set these on the repository when it connected it (and sets
        # them again on every Provision). Registry, deploy identity and
        # cluster are the install's facts, so they live there and not here:
        # this file is the same under any Gojira. Unset means this repo is
        # not connected to the Gojira whose workflow is running.
        env:
{% for name in names %}
{% if name.startswith(env.var_prefix ~ '_') %}          {{ name }}: {{ v(env, name[(env.var_prefix | length) + 1:]) }}
{% else %}          {{ name }}: ${{ '{{' }} vars.{{ name }} {{ '}}' }}
{% endif %}{% endfor %}
        run: |
          for name in {{ names | join(' ') }}; do
            if [ -z "${!name}" ]; then
              echo "::error::$name is not set on this repository — it is not connected to a Gojira that set it. Connect the repo there, or press Provision again."
              exit 1
            fi
          done
{%- endmacro %}

{% macro contract_check() %}
      - name: Verify manifests match gojira.yaml
        # gojira.yaml and the manifests it implies can land in two commits
        # (a contract push, then Gojira's setup PR). Deploying the first
        # one ships a new image against stale manifests (finding #20:
        # clio's slack transport with no slack secret, ten minutes of
        # crashloop). GOJIRA_CONTRACT is the fingerprint of the contract
        # these manifests were rendered from — same canonical hash as
        # gojira.generator.contract_fingerprint. Fail here, before a build.
        run: |
          # A bare self-hosted runner (GitHub's actions-runner image) has python3
          # without pip; its sudo is passwordless, so the distro package does.
          python3 -c 'import yaml' 2>/dev/null \
            || python3 -m pip install -q pyyaml 2>/dev/null \
            || { sudo apt-get -qq update && sudo apt-get -qq install -y python3-yaml >/dev/null; } \
            || { echo "::error::this runner has no python3 with PyYAML and none could be installed"; exit 1; }
          actual=$(python3 -c 'import hashlib, json, yaml; doc = yaml.safe_load(open("gojira.yaml")); print(hashlib.sha256(json.dumps(doc, sort_keys=True, separators=(",", ":"), default=str).encode()).hexdigest())')
          if [ "$actual" != "$GOJIRA_CONTRACT" ]; then
            echo "::error::k8s/ and workflows are stale for this gojira.yaml (contract $actual, manifests rendered from $GOJIRA_CONTRACT). Merge Gojira's setup PR, or press Provision again, then redeploy."
            exit 1
          fi
{%- endmacro %}

{% macro runner_tools(kustomize) %}
      - name: Tools the runner may lack
        # GitHub's hosted runners carry all of these. A self-hosted runner
        # needs docker (for apps built from their repo) and nothing else:
        # what is missing is fetched here, pinned. kubectl comes from the
        # gcloud setup-gcloud just installed; kustomize is not a gcloud
        # component, so its release tarball is fetched and checked against
        # the sha256 kustomize publishes. The GKE auth plugin is not needed:
        # get-gke-credentials writes the auth step's token into kubeconfig.
        run: |
          command -v kubectl >/dev/null || gcloud components install kubectl --quiet
          if ! command -v kustomize >/dev/null; then
            case "$(uname -m)" in
              x86_64) arch=amd64; sum={{ kustomize.sha256.amd64 }} ;;
              aarch64|arm64) arch=arm64; sum={{ kustomize.sha256.arm64 }} ;;
              *) echo "::error::no kustomize build for $(uname -m)"; exit 1 ;;
            esac
            curl -fsSLo kustomize.tgz "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F{{ kustomize.version }}/kustomize_{{ kustomize.version }}_linux_${arch}.tar.gz"
            echo "$sum  kustomize.tgz" | sha256sum -c - >/dev/null
            tar -xzf kustomize.tgz kustomize && rm kustomize.tgz
            mkdir -p "$HOME/.local/bin" && mv kustomize "$HOME/.local/bin/kustomize"
            echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          fi
{%- endmacro %}

{% macro deploy_step(name, namespace, app, tag_expr, is_cron, ksa='') %}
      - name: Deploy to {{ name }}
        run: |
          cd k8s/overlays/{{ name }}
          # Pin the manifest to the digest the registry holds for this tag,
          # not the tag alone: a re-run on an unchanged commit (the Redeploy
          # button) rebuilds under the SAME tag, so a tag-only reference makes
          # the apply a silent no-op while a different image sits in the
          # registry. The digest rolls pods exactly when the built bytes
          # changed; the tag stays in the ref for humans reading the cluster.
          # tags list, not images describe: describe also queries Container
          # Analysis (containeranalysis.occurrences.list), which no AR role
          # grants — it works here only while the runner's gcloud happens not
          # to make that call. tags list answers from AR alone.
          DIGEST=$(gcloud artifacts docker tags list "$IMAGE" --filter="tag:{{ tag_expr }}" --format='value(version)')
          kustomize edit set image gojira-app="$IMAGE:{{ tag_expr }}@$DIGEST"

{% if not is_cron %}
          # Two-phase apply so the workload is not blocked by GMP's admission
          # webhook, which can be unavailable for several minutes on a cold
          # cluster (the GMP operator needs a node provisioned first).
          #
          # Phase 1 — bring the workload up. A GMP Rules rejection while the
          # operator is still cold is tolerated here and reconciled in phase 2;
          # any other error still fails the deploy after the retries.
{% else %}
          # Retry the apply: a cold cluster may have no nodes yet. A genuine
          # error still fails after the retries.
{% endif %}
          # A manifest that does not build is a deterministic error, not a cold
          # cluster: it fails here, once, with kustomize's message. The retries
          # below are for the cluster.
          kubectl kustomize . > /dev/null
          ok=false
          for attempt in $(seq 1 20); do
            rc=0; out=$(kubectl apply -k . 2>&1) || rc=$?  # || so bash -e can't kill the retry loop
            echo "$out"
            [ "$rc" -eq 0 ] && { ok=true; break; }
{% if not is_cron %}
            if echo "$out" | grep -q 'gmp-operator'; then
              echo "GMP operator still cold — workload applied, will reconcile Rules"
              ok=true; break
            fi
{% endif %}
            echo "apply attempt $attempt failed; waiting for cluster to settle..."
            sleep 30
          done
          [ "$ok" = true ] || { echo "deploy failed after retries"; exit 1; }
{% if ksa %}
          # The pod's Google identity (gojira.yaml identity:). The email names
          # a project, so it comes from this environment's variable, not from
          # the manifest; apply never managed this annotation, so it keeps it.
          # GKE resolves the mapping when a pod asks for a token, so pods
          # started a moment before this line still get it.
          kubectl -n {{ namespace }} annotate serviceaccount {{ ksa }} \
            "iam.gke.io/gcp-service-account=$RUN_SA" --overwrite
{% endif %}
{% if not is_cron %}
          kubectl -n {{ namespace }} rollout status deployment/{{ app }} --timeout=600s

          # Phase 2 — reconcile the GMP Rules CR now the operator's webhook is up.
          ok=false
          for attempt in $(seq 1 20); do
            if kubectl apply -k .; then ok=true; break; fi
            echo "Rules apply attempt $attempt failed; waiting for gmp-operator..."
            sleep 30
          done
          [ "$ok" = true ] || { echo "GMP Rules failed to apply after retries"; exit 1; }
{% endif %}
{%- endmacro %}
