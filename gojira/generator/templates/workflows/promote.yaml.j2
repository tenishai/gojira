# Generated by Gojira. Edits will be overwritten on regeneration —
# change gojira.yaml instead.
#
# Flow: push a v* tag → each downstream env is promoted in order. Build-from-
# scratch envs (e.g. qa) build and push their own image; the final env (prod)
# crane-copies the exact image its predecessor built and tested — no rebuild —
# then deploys. Prod waits on the "production" GitHub environment's protection
# rule (required reviewers) — approve in the Actions run.
name: Gojira Promote
{% import 'workflows/_deploy.j2' as d %}

on:
  push:
    tags: ['v*']

concurrency:
  group: gojira-deploy-{{ '${{ github.repository }}' }}-{{ '${{ github.workflow }}' }}
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write

env:
  GOJIRA_CONTRACT: {{ contract_sha }}

jobs:
{% for env in spec.promote_envs %}
{% set source = (spec.environments | selectattr('name', 'equalto', env.copy_from) | first) if env.copy_from else none %}
  deploy-{{ env.name }}:
{% if not loop.first %}
    needs: deploy-{{ spec.promote_envs[loop.index0 - 1].name }}
{% endif %}
    # A repo or org variable CI_RUNNER names a self-hosted runner label; unset, GitHub's.
    runs-on: {{ "${{ vars.CI_RUNNER || 'ubuntu-latest' }}" }}
{% if env.gated %}
    environment: production
{% endif %}
    env:
      IMAGE: {{ d.v(env, 'AR_REPO') }}/{{ spec.app }}
{% if spec.identity %}
      RUN_SA: {{ d.v(env, 'RUN_SA') }}
{% endif %}
{% if source %}
      SOURCE_IMAGE: {{ d.v(source, 'AR_REPO') }}/{{ spec.app }}
{% endif %}
    steps:
      - uses: actions/checkout@v4

{{ d.require_vars(env, env.platform_variables(spec.run_gsa(env))) }}
{% if source %}
{{ d.require_vars(source, source.platform_variables()) }}
{% endif %}

{{ d.contract_check() }}

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: {{ d.v(env, 'WIF_PROVIDER') }}
          service_account: {{ d.v(env, 'DEPLOY_SA') }}

      - uses: google-github-actions/setup-gcloud@v2
{% if source %}

      - uses: imjasonh/setup-crane@v0.4

      - name: Copy tested image from {{ source.name }} (no rebuild)
        # Whether the two environments share a registry is the install's
        # business, so it is decided here from the variables, not rendered.
        run: |
          if [ "$SOURCE_IMAGE" = "$IMAGE" ]; then
            echo "{{ env.name }} shares {{ source.name }}'s registry — the tested image is already present"
            exit 0
          fi
          gcloud auth configure-docker "${SOURCE_IMAGE%%/*}" --quiet
          gcloud auth configure-docker "${IMAGE%%/*}" --quiet
          crane copy "$SOURCE_IMAGE:$GITHUB_REF_NAME" "$IMAGE:$GITHUB_REF_NAME"
{% else %}

      - name: Configure docker for Artifact Registry
        run: gcloud auth configure-docker "${IMAGE%%/*}" --quiet

      - name: Build and push image
        # AR_TOKEN: see ci.yaml — private AR package indexes via WIF.
        run: |
          docker build --build-arg AR_TOKEN="$(gcloud auth print-access-token)" -t "$IMAGE:$GITHUB_REF_NAME" .
          docker push "$IMAGE:$GITHUB_REF_NAME"
{% endif %}

      - uses: google-github-actions/get-gke-credentials@v2
        with:
          cluster_name: {{ d.v(env, 'GKE_CLUSTER') }}
          location: {{ d.v(env, 'LOCATION') }}
          project_id: {{ d.v(env, 'PROJECT') }}
          use_dns_based_endpoint: true  # see gojira-ci.yaml (finding #14)

{{ d.deploy_step(env.name, env.namespace, spec.app, '$GITHUB_REF_NAME', is_cron, spec.ksa_name if spec.identity else '') }}
{% endfor %}
