# Generated by Gojira. Edits will be overwritten on regeneration —
# change gojira.yaml instead.
{% import 'workflows/_deploy.j2' as d %}
{% set env = spec.ci_env %}
name: Gojira CI

on:
  push:
    branches: [{{ spec.default_branch }}]
  workflow_dispatch: {}  # Gojira's Redeploy button

concurrency:
  group: gojira-deploy-{{ '${{ github.repository }}' }}-{{ '${{ github.workflow }}' }}
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write

env:
  IMAGE: {{ d.v(env, 'AR_REPO') }}/{{ spec.app }}
{% if spec.identity %}
  RUN_SA: {{ d.v(env, 'RUN_SA') }}
{% endif %}
  GOJIRA_CONTRACT: {{ contract_sha }}

jobs:
  build-and-deploy-{{ env.name }}:
    # A repo or org variable CI_RUNNER names a self-hosted runner label; unset, GitHub's.
    runs-on: {{ "${{ vars.CI_RUNNER || 'ubuntu-latest' }}" }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0

{{ d.require_vars(env, (env.platform_variables(spec.run_gsa(env)) | list) + spec.build_arg_refs()) }}

{{ d.contract_check() }}

      - id: auth
        uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed  # v2.1.13
        with:
          workload_identity_provider: {{ d.v(env, 'WIF_PROVIDER') }}
          service_account: {{ d.v(env, 'DEPLOY_SA') }}

      - uses: google-github-actions/setup-gcloud@e427ad8a34f8676edf47cf7d7925499adf3eb74f  # v2.2.1

      - name: Configure docker for Artifact Registry
        run: gcloud auth configure-docker "${IMAGE%%/*}" --quiet
{% if spec.published_image %}

      - uses: imjasonh/setup-crane@31b88efe9de28ae0ffa220711af4b60be9435f6e  # v0.4

      - name: Copy the published image (no build)
        # The contract names an image someone else built and published. It is
        # copied, every platform of it, into this install's registry under this
        # commit's tag, so the deploy below pins a digest this registry holds
        # and rollback, promote and the drift sweep see exactly what a build
        # would have left. The deploy identity must be able to read the
        # source: a public registry needs nothing; a private Artifact Registry
        # needs it granted roles/artifactregistry.reader there.
        run: |
          TAG="${GITHUB_SHA::12}"
          SOURCE={{ spec.published_image | shell }}
          case "$SOURCE" in *.pkg.dev/*|*gcr.io/*) gcloud auth configure-docker "${SOURCE%%/*}" --quiet ;; esac
          crane copy "$SOURCE" "$IMAGE:$TAG"
{% else %}

      - name: Build and push image
        # AR_TOKEN lets a Dockerfile resolve private Artifact Registry package
        # indexes (pip --extra-index-url, npm) with this workflow's own WIF
        # identity. It goes in as a BuildKit secret (never a build arg, which
        # the build log prints); Dockerfiles that mount no such secret ignore it.
        env:
          DOCKER_BUILDKIT: "1"
        run: |
          TAG="${GITHUB_SHA::12}"
          # Build only when the image's inputs changed. The image is a function of the
          # Dockerfile and its build arguments, not of the commit: a push that changes
          # settings, a bundle or a picture must not spend three minutes rebuilding the
          # same bytes (tenishai/kobo#434). The registry remembers each build under a
          # second tag, build-<sha of the Dockerfile blob>; when that tag exists the
          # commit's tag is added to the same digest and the build is skipped. The
          # Redeploy button (workflow_dispatch) always builds.
          BUILD_KEY="build-$(git rev-parse "HEAD:Dockerfile" | cut -c1-12)"
          EXISTING=""
          if [ "${{ '{{' }} github.event_name {{ '}}' }}" != "workflow_dispatch" ]; then
            EXISTING=$(gcloud artifacts docker tags list "$IMAGE" --filter="tag:$BUILD_KEY" --format='value(version)' 2>/dev/null || true)
          fi
          if [ -n "$EXISTING" ]; then
            echo "image for this Dockerfile already built ($BUILD_KEY -> $EXISTING); tagging it $TAG, no build"
            gcloud artifacts docker tags add "$IMAGE@$EXISTING" "$IMAGE:$TAG" --quiet
            exit 0
          fi
          AR_TOKEN="$(gcloud auth print-access-token)"
          export AR_TOKEN
          docker build --platform linux/{{ spec.effective_arch }} --secret id=ar_token,env=AR_TOKEN{% for k, v in spec.build_args | dictsort %} \
{% if v | variable_ref %}            --build-arg {{ k }}="${{ '{{' }} vars.{{ v | variable_ref }} {{ '}}' }}"{% else %}            --build-arg {{ (k ~ "=" ~ v) | shell }}{% endif %}{% endfor %} -t "$IMAGE:$TAG" -t "$IMAGE:$BUILD_KEY" .
          docker push "$IMAGE:$TAG"
          docker push "$IMAGE:$BUILD_KEY"
{% endif %}

      - uses: google-github-actions/get-gke-credentials@64bc7249bbcf78056bb92f14d3cedc2da193946c  # v2.3.5
        with:
          cluster_name: {{ d.v(env, 'GKE_CLUSTER') }}
          location: {{ d.v(env, 'LOCATION') }}
          project_id: {{ d.v(env, 'PROJECT') }}
          # IAM-authenticated DNS endpoint: works for private control planes
          # (GitHub runners can't reach a private IP) and public ones alike.
          # The provisioner ensures DNS access is enabled on every registered
          # cluster (finding #14).
          use_dns_based_endpoint: true

{{ d.deploy_step(env.name, env.namespace, spec.app, '${GITHUB_SHA::12}', is_cron, spec.ksa_name if spec.identity else '') }}
