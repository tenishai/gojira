# Generated by Gojira. Edits will be overwritten on regeneration —
# change gojira.yaml instead.
{% import 'workflows/_deploy.j2' as d %}
{% set env = spec.ci_env %}
name: Gojira CI

on:
  push:
    branches: [{{ spec.default_branch }}]

permissions:
  contents: read
  id-token: write

env:
  IMAGE: {{ env.ar_repo }}/{{ spec.app }}

jobs:
  build-and-deploy-{{ env.name }}:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: {{ env.wif_provider }}
          service_account: {{ env.gsa_email }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: Configure docker for Artifact Registry
        run: gcloud auth configure-docker {{ env.ar_host }} --quiet

      - name: Build and push image
        # AR_TOKEN lets a Dockerfile resolve private Artifact Registry package
        # indexes (pip --extra-index-url, npm) with this workflow's own WIF
        # identity. Dockerfiles that declare no such ARG ignore it.
        run: |
          TAG="${GITHUB_SHA::12}"
          docker build --build-arg AR_TOKEN="$(gcloud auth print-access-token)" -t "$IMAGE:$TAG" .
          docker push "$IMAGE:$TAG"

      - uses: google-github-actions/get-gke-credentials@v2
        with:
          cluster_name: {{ env.gke_cluster }}
          location: {{ env.location }}
          project_id: {{ env.project }}

{{ d.deploy_step(env.name, env.namespace, spec.app, '${GITHUB_SHA::12}', is_cron) }}
