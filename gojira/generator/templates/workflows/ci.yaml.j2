# Generated by Gojira. Edits will be overwritten on regeneration —
# change gojira.yaml instead.
{% set env = spec.ci_env %}
name: Gojira CI

on:
  push:
    branches: [{{ spec.default_branch }}]

permissions:
  contents: read
  id-token: write

env:
  IMAGE: {{ env.ar_repo }}/{{ spec.app }}

jobs:
  build-and-deploy-{{ env.name }}:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: {{ env.wif_provider }}
          service_account: {{ env.gsa_email }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: Configure docker for Artifact Registry
        run: gcloud auth configure-docker {{ env.ar_host }} --quiet

      - name: Build and push image
        run: |
          TAG="${GITHUB_SHA::12}"
          docker build -t "$IMAGE:$TAG" .
          docker push "$IMAGE:$TAG"

      - uses: google-github-actions/get-gke-credentials@v2
        with:
          cluster_name: {{ env.gke_cluster }}
          location: {{ env.location }}
          project_id: {{ env.project }}

      - name: Deploy to {{ env.name }}
        run: |
          TAG="${GITHUB_SHA::12}"
          cd k8s/overlays/{{ env.name }}
          kustomize edit set image gojira-app="$IMAGE:$TAG"
          # Retry: a cold cluster may have no nodes yet, so operator admission
          # webhooks (e.g. GMP, which validates the Rules resource) can be
          # briefly unavailable. A genuine error still fails after the retries.
          ok=false
          for attempt in $(seq 1 10); do
            if kubectl apply -k .; then ok=true; break; fi
            echo "apply attempt $attempt failed; waiting for cluster to settle..."
            sleep 30
          done
          [ "$ok" = true ] || { echo "deploy failed after retries"; exit 1; }
          {% if not is_cron %}
          kubectl -n {{ env.namespace }} rollout status deployment/{{ spec.app }} --timeout=300s
          {% endif %}
