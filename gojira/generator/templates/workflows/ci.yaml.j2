# Generated by Gojira. Edits will be overwritten on regeneration —
# change gojira.yaml instead.
name: Gojira CI

on:
  push:
    branches: [{{ spec.default_branch }}]

permissions:
  contents: read
  id-token: write

env:
  IMAGE: {{ spec.image }}

jobs:
  build-and-deploy-dev:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: {{ spec.wif_provider }}
          service_account: {{ spec.gsa_email }}

      - uses: google-github-actions/setup-gcloud@v2

      - name: Configure docker for Artifact Registry
        run: gcloud auth configure-docker {{ spec.ar_host }} --quiet

      - name: Build and push image
        run: |
          TAG="${GITHUB_SHA::12}"
          docker build -t "$IMAGE:$TAG" .
          docker push "$IMAGE:$TAG"

      - uses: google-github-actions/get-gke-credentials@v2
        with:
          cluster_name: {{ spec.gke_cluster }}
          location: {{ spec.location }}
          project_id: {{ spec.gcp_project }}

      - name: Deploy to dev
        run: |
          TAG="${GITHUB_SHA::12}"
          cd k8s/overlays/dev
          kustomize edit set image gojira-app="$IMAGE:$TAG"
          kubectl apply -k .
          {% if not is_cron %}
          kubectl -n {{ spec.namespace }} rollout status deployment/{{ spec.app }} --timeout=180s
          {% endif %}
